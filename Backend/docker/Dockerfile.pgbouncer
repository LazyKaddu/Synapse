# ==============================================================================
# Dockerfile: Synapse PgBouncer Connection Pooler (AWS RDS & PostgreSQL Proxy)
# ==============================================================================
# Lightweight PgBouncer proxy layer designed to sit between Synapse microservices
# and AWS RDS PostgreSQL, mitigating connection spikes ("thundering herd" logins)
# via high-throughput transaction pooling.
# ==============================================================================

FROM edoburu/pgbouncer:v1.23.0

# Copy default Synapse PgBouncer configuration template
COPY pgbouncer/pgbouncer.ini /etc/pgbouncer/pgbouncer.ini

# Default environment variables for database connection pooling.
# In production (Kubernetes/ECS), override DB_HOST with your AWS RDS endpoint:
# e.g., DB_HOST=synapse-db.c123456789.us-east-1.rds.amazonaws.com
ENV DB_USER=synapse_user \
    DB_PASSWORD=synapse_password \
    DB_HOST=postgres \
    DB_PORT=5432 \
    DB_NAME=synapse_mmo \
    POOL_MODE=transaction \
    MAX_CLIENT_CONN=10000 \
    DEFAULT_POOL_SIZE=50 \
    MIN_POOL_SIZE=10 \
    RESERVE_POOL_SIZE=5 \
    MAX_DB_CONNECTIONS=100

EXPOSE 6432

