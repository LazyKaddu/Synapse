# ==============================================================================
# Synapse MMO Backend - Environment Variables Template
# ==============================================================================

# Server Identity & Region
SYNAPSE_ENV=development
SYNAPSE_REGION=eu-west
SYNAPSE_SHARD_ID=1

# Networking
SYNAPSE_GATEWAY_HOST=0.0.0.0
SYNAPSE_GATEWAY_PORT=8080
SYNAPSE_GAME_SERVER_HOST=0.0.0.0
SYNAPSE_GAME_SERVER_PORT=9000
SYNAPSE_METRICS_PORT=9100

# Security & JWT
SYNAPSE_JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_32_bytes_min
SYNAPSE_JWT_EXPIRATION_HOURS=24
SYNAPSE_BOARDING_PASS_EXPIRATION_SECONDS=60

# Database (PostgreSQL via PgBouncer)
SYNAPSE_DATABASE_MASTER_URL=postgres://synapse_user:synapse_password@127.0.0.1:6432/synapse_mmo
SYNAPSE_DATABASE_REPLICA_URLS=postgres://synapse_user:synapse_password@127.0.0.1:6432/synapse_mmo
SYNAPSE_DATABASE_MAX_CONNECTIONS=50
SYNAPSE_DATABASE_READ_AFTER_WRITE_WINDOW_SECS=4

# Redis (Hot Cache, Warm Write-Back, & Presence Pub/Sub)
SYNAPSE_REDIS_URL=redis://127.0.0.1:6379/0
SYNAPSE_GLOBAL_REDIS_URL=redis://127.0.0.1:6379/1

# LiveKit SFU (Audio Matrix)
SYNAPSE_LIVEKIT_HOST=http://127.0.0.1:7880
SYNAPSE_LIVEKIT_API_KEY=devkey
SYNAPSE_LIVEKIT_API_SECRET=secret

# Game Engine Tuning
SYNAPSE_TICK_RATE_HZ=10
SYNAPSE_CHUNK_SIZE=1000
SYNAPSE_WORLD_SEED=133742
SYNAPSE_MAX_VOICE_TRACKS=50
SYNAPSE_VOICE_HYSTERESIS_MAX=60
SYNAPSE_MEGA_CROWD_THRESHOLD=500
SYNAPSE_FLUSH_INTERVAL_SECS=180
